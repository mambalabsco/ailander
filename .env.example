# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Copia este archivo a .env.local y rellena los valores de tu proyecto.
# .env.local está en .gitignore: nunca se sube al repositorio.
#
# Los dos primeros llegan al navegador por diseño y no son secretos: lo único
# que permiten es lo que permitan las políticas RLS.
# Panel de Supabase → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Clave secreta (solo servidor)
# ---------------------------------------------------------------------------
# Salta todas las políticas RLS. NO la pongas en ninguna variable que empiece
# por NEXT_PUBLIC_ ni la importes desde un componente cliente.
#
# En este proyecto solo se usa para leer las claves de API del usuario, que a
# propósito no tienen permiso de lectura desde el navegador.

SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Conexión a Postgres (solo para migraciones)
# ---------------------------------------------------------------------------
# NO es ninguna de las claves de arriba: aquellas son de API y no sirven para
# crear tablas. Panel → botón «Connect» → pestaña URI, y sustituye
# [YOUR-PASSWORD] por la contraseña de la base de datos.
#
# Puerto 5432 (sesión), no 6543: el modo transacción no admite todo lo que
# hacen las migraciones.
#
# Solo la necesitan `npm run db:push` y `npm run db:verify`. La aplicación no la
# usa nunca. Los scripts leen este archivo solos, así que basta con dejarla aquí.
#
# Si la contraseña lleva # / ? sustitúyelos por %23 %2F %3F, y % por %25.
# Los demás signos (! $ & * +) van tal cual.

SUPABASE_DB_URL=

# Referencia del proyecto, para regenerar los tipos con `npm run db:types`.
SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# URL pública de la aplicación
# ---------------------------------------------------------------------------
# Se usa para construir los enlaces de confirmación de correo y como site_url
# en supabase/config.toml.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Meta Ads — para el botón «Iniciar sesión con Facebook»
# ---------------------------------------------------------------------------
# Son de la app de Meta, no de una tienda: **una sola app sirve para todas tus
# cuentas publicitarias**. Por eso van aquí y no en cada tienda, al contrario que
# las de Shopify, que exige una app distinta por tienda.
#
# developers.facebook.com/apps → tu app → Configuración → Básica.
#
# En Facebook Login → Configuración, la URI de redireccionamiento tiene que ser
# exactamente:  https://TU-DOMINIO/api/meta/callback
#
# El secreto no llega nunca al navegador: se usa para canjear el código y para
# firmar el estado anti-CSRF. Cómo sacarlo, en docs/anuncios.md.

META_APP_ID=
META_APP_SECRET=

# Solo si tu app es de tipo Empresa y usa «Facebook Login for Business», que es
# lo normal ahora. Ese flujo no pide los permisos con `scope` sino con el id de
# una **configuración** que se crea en el panel: Facebook Login for Business →
# Configuraciones → Crear, con el permiso `ads_read`.
#
# Si la configuración te deja elegir tipo de token, elige **usuario de sistema**:
# ese no caduca y te ahorra reconectar. Déjalo vacío si tu app usa el login
# clásico; entonces se usa `scope`, que sigue funcionando.
META_CONFIG_ID=

# ---------------------------------------------------------------------------
# Google Ads — para el botón «Iniciar sesión con Google»
# ---------------------------------------------------------------------------
# console.cloud.google.com → Credenciales → ID de cliente de OAuth, tipo
# «Aplicación web», con esta URI de redireccionamiento:
#     https://TU-DOMINIO/api/google/callback
#
# Publica la pantalla de consentimiento. En «modo de prueba» el permiso caduca
# cada siete días, y el síntoma —un invalid_grant la semana siguiente— no tiene
# ninguna relación aparente con lo que hiciste.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# El developer token **no sale de ningún login**: se pide en el API Center de tu
# cuenta administradora de Google Ads y lo aprueba una persona. Sin él, Google
# Ads no responde aunque el login haya funcionado.
GOOGLE_ADS_DEVELOPER_TOKEN=

# ---------------------------------------------------------------------------
# Versiones de API (opcionales)
# ---------------------------------------------------------------------------
# Solo hacen falta si una de las dos plataformas rompe algo y hay que fijar una
# versión distinta sin tocar código. Vacías, se usa la vigente.

# META_API_VERSION=v26.0
# GOOGLE_ADS_API_VERSION=v25

# ---------------------------------------------------------------------------
# Vídeo — voz, keyframes, animación y montaje
# ---------------------------------------------------------------------------
# El pipeline de vídeo usa tres proveedores. Sin ellos la pestaña de Vídeos lo
# dice y no deja lanzar nada, en vez de fallar a mitad con el gasto hecho.

# Voz con marcas de tiempo por palabra. El endpoint con marcas cuesta lo mismo
# que el normal —se cobra por carácter— y evita tener que transcribir después.
ELEVENLABS_API_KEY=

# Keyframes (~$0,02/imagen) y animación (~$0,07/segundo).
KIE_API_KEY=

# Montaje del vídeo final. Va fuera del servidor a propósito: el quemado tarda
# ~50 s por minuto de vídeo en 16 núcleos, y este servidor tiene 2.
FAL_KEY=
